VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Web Push — public key only (safe to expose client-side). Generate a pair
# with `npx web-push generate-vapid-keys`; the matching private key is a
# Supabase Edge Function secret (VAPID_PRIVATE_KEY), never put here.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
