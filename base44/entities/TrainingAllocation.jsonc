{
  "name": "TrainingAllocation",
  "type": "object",
  "properties": {
    "allocation_type": {
      "type": "string",
      "title": "Type",
      "enum": [
        "Team",
        "Squad"
      ]
    },
    "team_id": {
      "type": "string",
      "title": "Team ID"
    },
    "squad_id": {
      "type": "string",
      "title": "Squad ID"
    },
    "venue_id": {
      "type": "string",
      "title": "Venue ID"
    },
    "court_id": {
      "type": "string",
      "title": "Court ID"
    },
    "venue": {
      "type": "string",
      "title": "Venue Name (display)"
    },
    "court": {
      "type": "string",
      "title": "Court Name (display)"
    },
    "day": {
      "type": "string",
      "title": "Day",
      "enum": [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday"
      ]
    },
    "start_time": {
      "type": "string",
      "title": "Start Time"
    },
    "end_time": {
      "type": "string",
      "title": "End Time"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "allocation_type",
    "day"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}