{
  "name": "Session",
  "type": "object",
  "properties": {
    "session_name": {
      "type": "string",
      "title": "Session Name"
    },
    "session_type": {
      "type": "string",
      "title": "Session Type",
      "enum": [
        "Team",
        "Private"
      ],
      "default": "Team"
    },
    "team_id": {
      "type": "string",
      "title": "Team"
    },
    "coach_email": {
      "type": "string",
      "title": "Coach Email"
    },
    "date": {
      "type": "string",
      "title": "Date",
      "format": "date"
    },
    "duration_minutes": {
      "type": "number",
      "title": "Duration (mins)"
    },
    "focus_target": {
      "type": "string",
      "title": "Focus Target",
      "enum": [
        "Us",
        "Opponent"
      ]
    },
    "focus_category": {
      "type": "string",
      "title": "Focus Category",
      "enum": [
        "Ball Handling",
        "Finishing",
        "Shooting",
        "Passing",
        "Decision Making",
        "Defense",
        "Footwork",
        "Transition",
        "Confidence",
        "Basketball IQ",
        "Rebounding",
        "Athletic Movement"
      ]
    },
    "focus_outcome": {
      "type": "string",
      "title": "Desired Outcome"
    },
    "opponent_name": {
      "type": "string",
      "title": "Opponent Name"
    },
    "opponent_strategy": {
      "type": "string",
      "title": "Opponent Strategy"
    },
    "counter_strategies": {
      "type": "string",
      "title": "Counter Strategies"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Planned",
        "In Progress",
        "Completed",
        "Cancelled"
      ],
      "default": "Planned"
    },
    "owner_user_email": {
      "type": "string",
      "title": "Owner Email"
    },
    "player_ids": {
      "type": "string",
      "title": "Player IDs (JSON)"
    },
    "session_blocks": {
      "type": "string",
      "title": "Session Blocks (JSON)"
    },
    "is_demo": {
      "type": "boolean",
      "title": "Demo Content",
      "default": false
    }
  },
  "required": [
    "session_name",
    "session_type",
    "team_id",
    "date"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "data.owner_user_email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.coach_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_user_email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.coach_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_user_email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}